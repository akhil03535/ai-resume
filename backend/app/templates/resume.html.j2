<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<style>
  @page { margin: 0.6in; }
  body { font-family: 'Helvetica', Arial, sans-serif; color: #0F172A; font-size: 10.5pt; line-height: 1.45; }
  h1 { font-size: 20pt; margin: 0 0 2px 0; color: #172554; }
  .headline { color: #475569; font-size: 11pt; margin-bottom: 6px; }
  .contact { font-size: 9pt; color: #475569; margin-bottom: 14px; }
  .contact span:not(:last-child)::after { content: " · "; }
  h2 { font-size: 11.5pt; text-transform: uppercase; letter-spacing: 0.04em; color: #172554;
       border-bottom: 1.2pt solid #2563EB; padding-bottom: 3px; margin: 16px 0 8px 0; }
  .entry { margin-bottom: 10px; }
  .entry-header { display: flex; justify-content: space-between; font-weight: 600; }
  .entry-sub { color: #475569; font-style: italic; font-size: 9.5pt; }
  ul { margin: 4px 0 0 0; padding-left: 16px; }
  li { margin-bottom: 2px; }
  .skills-list span { display: inline-block; background: #F8FAFC; border: 0.8pt solid #E2E8F0;
      border-radius: 3px; padding: 2px 7px; margin: 0 5px 5px 0; font-size: 9.5pt; }
  /* variant: modern */
  body.modern h1 { color: #4F46E5; }
  body.modern h2 { border-bottom-color: #4F46E5; }
  /* variant: technical */
  body.technical h2 { border-bottom: none; background: #F8FAFC; padding: 4px 8px; }
</style>
</head>
<body class="{{ css_variant }}">
  <h1>{{ personal.full_name or "" }}</h1>
  {% if personal.headline %}<div class="headline">{{ personal.headline }}</div>{% endif %}
  <div class="contact">
    {% if personal.email %}<span>{{ personal.email }}</span>{% endif %}
    {% if personal.phone %}<span>{{ personal.phone }}</span>{% endif %}
    {% if personal.location %}<span>{{ personal.location }}</span>{% endif %}
    {% for link in links %}<span>{{ link.label }}: {{ link.url }}</span>{% endfor %}
  </div>

  {% if summary %}
  <h2>Summary</h2>
  <p>{{ summary }}</p>
  {% endif %}

  {% if skills %}
  <h2>Skills</h2>
  <div class="skills-list">{% for s in skills %}<span>{{ s }}</span>{% endfor %}</div>
  {% endif %}

  {% if experience %}
  <h2>Experience</h2>
  {% for e in experience %}
  <div class="entry">
    <div class="entry-header"><span>{{ e.title }}, {{ e.company }}</span><span>{{ e.start_date or "" }} – {{ "Present" if e.is_current else (e.end_date or "") }}</span></div>
    {% if e.location %}<div class="entry-sub">{{ e.location }}</div>{% endif %}
    <ul>{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
  </div>
  {% endfor %}
  {% endif %}

  {% if projects %}
  <h2>Projects</h2>
  {% for p in projects %}
  <div class="entry">
    <div class="entry-header"><span>{{ p.name }}</span></div>
    {% if p.technologies %}<div class="entry-sub">{{ p.technologies|join(", ") }}</div>{% endif %}
    <ul>{% for b in p.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
  </div>
  {% endfor %}
  {% endif %}

  {% if education %}
  <h2>Education</h2>
  {% for ed in education %}
  <div class="entry">
    <div class="entry-header"><span>{{ ed.degree or "" }}{% if ed.field_of_study %}, {{ ed.field_of_study }}{% endif %}</span><span>{{ ed.end_date or "" }}</span></div>
    <div class="entry-sub">{{ ed.institution }}{% if ed.gpa %} · GPA: {{ ed.gpa }}{% endif %}</div>
  </div>
  {% endfor %}
  {% endif %}

  {% if certifications %}
  <h2>Certifications</h2>
  <ul>{% for c in certifications %}<li>{{ c.name }}{% if c.issuer %} — {{ c.issuer }}{% endif %}</li>{% endfor %}</ul>
  {% endif %}

  {% if achievements %}
  <h2>Achievements</h2>
  <ul>{% for a in achievements %}<li>{{ a.title }}{% if a.description %} — {{ a.description }}{% endif %}</li>{% endfor %}</ul>
  {% endif %}
</body>
</html>
