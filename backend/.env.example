# --- Database ---
DATABASE_URL=postgresql+psycopg2://resumeai:resumeai@postgres:5432/resumeai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=8
UPLOAD_DIR=/app/uploads

# --- Production object storage ---
# Required only when ENV=production. Keep the bucket private.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=resumes

# --- AI provider ---
# REQUIRED for any AI feature (resume parsing, JD analysis, bullet
# improvement, resume summary generation) to work at all. If this is empty,
# the backend still starts normally, but every AI call fails immediately
# with a clear "ai_missing_api_key" error (see server logs, tagged
# "[A - MISSING API KEY]") rather than a vague timeout.
# Get a key at https://console.groq.com
AI_PROVIDER=groq
GROQ_API_KEY=

# Must be a model currently available on your Groq account - verify at
# https://console.groq.com/docs/models. A wrong/retired model name produces
# a distinct "ai_invalid_model" error (server logs: "[G - INVALID MODEL]"),
# not the generic "AI unavailable" message.
#AI_MODEL=llama-3.3-70b-versatile
#AI_MODEL=llama-3.1-8b-instant
AI_MODEL=openai/gpt-oss-20b
# 0.0-2.0. Lower = more deterministic/consistent structured output, which is
# preferred here since this drives resume/profile data, not creative writing.
AI_TEMPERATURE=0.2
# How many times a single AI call retries on failure before giving up.
AI_MAX_RETRIES=2

# --- App ---
APP_NAME=AI Resume Analyzer
API_PREFIX=/api
ENV=development
# Controls logging verbosity only. Does NOT affect whether raw
# tracebacks/internals can leak to HTTP responses - that protection is
# unconditional regardless of this setting.
DEBUG=true

# --- ATS scoring weights (advanced - optional, sensible defaults apply) ---
# Must each be 0.0-1.0 and should sum to ~1.0 across all eight. Only change
# these if you understand app/analysis/scoring.py - the defaults are the
# ones documented/tested throughout this codebase.
# ATS_WEIGHT_REQUIRED_SKILLS=0.30
# ATS_WEIGHT_PREFERRED_SKILLS=0.10
# ATS_WEIGHT_KEYWORDS=0.15
# ATS_WEIGHT_EXPERIENCE=0.15
# ATS_WEIGHT_PROJECTS=0.10
# ATS_WEIGHT_SECTION_COMPLETENESS=0.10
# ATS_WEIGHT_FORMATTING=0.05
# ATS_WEIGHT_EDUCATION=0.05

